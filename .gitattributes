# Normalise line endings in the repository regardless of the machine a commit
# is made from. Without this it depends on each clone's core.autocrlf, and the
# production checkout drifted by 29,000 lines across three files that were
# byte-identical apart from CR characters — deployed by scp from Windows onto
# a tree whose committed content is LF.
* text=auto eol=lf

# Binary: never touch these.
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
